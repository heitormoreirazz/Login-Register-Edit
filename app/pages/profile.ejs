<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="/controller/cepAPI.js" defer></script>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <title>Meu Perfil</title>
  <link rel="stylesheet" href="../sources/profile.css" />
</head>

<body>
  <main class="page">
    <aside class="sidebar">
      <section class="brand">Minha Conta</section>

      <nav class="nav">
        <a href="#" class="active">Perfil</a>
      </nav>
    </aside>

    <main class="content">
      <section class="topbar">
        <h1>Editar perfil</h1>
        <form action="/logout" method="POST" style="margin: 0;">
          <button type="submit" class="btnlogout">
            <i class="bi bi-box-arrow-right"></i> Sair
          </button>
        </form>
      </section>

      <section class="grid">
        <section class="card">
          <h2>Informações pessoais</h2>

          <form action="/editarInfo" method="POST">
            <section class="form-grid">
              <section class="field">
                <label for="nome">Nome</label>
                <input id="nome" type="text" value="<%= nome %>" name="nome" />
              </section>

              <section class="field">
                <label for="sobrenome">Sobrenome</label>
                <input id="sobrenome" type="text" value="<%= sobrenome %>" name="sobrenome" />
              </section>

              <section class="field full">
                <label for="email">E-mail</label>
                <input id="email" type="email" value="<%= email %>" name="email" />
              </section>

              <section class="field">
                <label for="telefone">Telefone</label>
                <input id="telefone" type="tel" value="<%= celular %>" name="celular" />
              </section>

              <section class="field">
                <label for="cpf">CPF</label>
                <input id="cpf" type="text" value="123.456.789-00" name="cpf" />
              </section>

              <section class="field">
                <label for="senha">Senha</label>
                <input id="senha" type="password" value="********" name="senha" />
              </section>

              <section class="field">
                <label for="confirmarSenha">Confirmar senha</label>
                <input id="confirmarSenha" type="password" value="********" name="confirmarSenha" />
              </section>

              <section class="field full">
                <label for="bio">Bio</label>
                <textarea id="bio" name="bio"> <%= bio %> </textarea>
              </section>
            </section>

            <section class="actions">
              <button type="button" class="btn btn-secondary">Cancelar</button>
              <button type="submit" class="btn btn-primary">Salvar perfil</button>
            </section>
          </form>
        </section>

        <aside class="card">
          <section class="profile-box">
            <section class="avatar" id="avatar">
              <% if (avatar_url && avatar_url.trim() !=='' ) { %>
                <img class="avatar-img show" id="avatarImage" src="<%= avatar_url %>">
                <% } else { %>
                  <img class="avatar-img" id="avatarImage" >
                  <% } %>

                    <div class="avatar-overlay">
                      <i class="bi bi-camera-fill"></i>
                    </div>
                    <div class="avatar-loading"></div>
            </section>

            <input type="file" id="avatarInput" accept="image/*">

            <button id="saveAvatarBtn" class="btn btn-primary" style="margin-top: 12px; width: 100%;">
              💾 Salvar Avatar
            </button>

            <h2>
              <%= nome %>
                <%= sobrenome %>
            </h2>
            <span class="status">Ativa agora</span>
          </section>

          <!-- Modal de confirmação -->
          <div class="avatar-modal">
            <div class="avatar-modal-content">
              <h3>Confirmar nova foto?</h3>
              <img class="avatar-modal-preview" alt="Pré-visualização">
              <p>Clique em confirmar para atualizar seu avatar</p>
              <div class="avatar-modal-buttons">
                <button class="avatar-modal-btn-confirm">✓ Confirmar</button>
                <button class="avatar-modal-btn-cancel">✕ Cancelar</button>
              </div>
            </div>
          </div>

          <!-- Mensagens -->
          <div class="avatar-error"></div>
          <div class="avatar-success"></div>

          <section class="meta">
            <section class="meta-item">
              <span>Tipo de conta</span>
              <strong>Premium</strong>
            </section>
            <section class="meta-item">
              <span>Último acesso</span>
              <strong>Hoje, 09:45</strong>
            </section>
            <section class="meta-item">
              <span>País</span>
              <strong>Brasil</strong>
            </section>
          </section>
        </aside>
      </section>

      <section class="card" style="margin-top: 24px;">
        <h2>Endereço</h2>

        <form action="/editarEndereco" method="POST">
          <section class="form-grid">
            <section class="field full">
              <label for="rua">Rua</label>
              <input id="rua" name="logradouro" type="text" value="<%= logradouro %>" />
            </section>

            <section class="field">
              <label for="bairro">Bairro</label>
              <input id="bairro" name="bairro" type="text" value="<%= bairro %>" />
            </section>

            <section class="field">
              <label for="numero">Número</label>
              <input id="numero" name="numero" type="text" value="<%= numero %>" />
            </section>

            <section class="field">
              <label for="complemento">Complemento</label>
              <input id="complemento" name="complemento" type="text" value="<%= complemento %>" />
            </section>

            <section class="field">
              <label for="cidade">Cidade</label>
              <input id="cidade" name="cidade" type="text" value="<%= cidade %>" />
            </section>

            <section class="field">
              <label for="estado">Estado</label>
              <input id="estado" name="estado" type="text" value="<%= estado %>" maxlength="2" />
            </section>

            <section class="field">
              <label for="cep">CEP</label>
              <input id="cep" name="cep" type="text" value="<%= cep %>" inputmode="numeric" autocomplete="postal-code"
                maxlength="9" aria-describedby="cep-status" />
              <small id="cep-status" class="cep-status" role="status" aria-live="polite"></small>
            </section>

            <section class="field">
              <label for="pais">País</label>
              <input id="pais" name="pais" type="text" value="Brasil" />
            </section>
          </section>

          <section class="actions">
            <button type="button" class="btn btn-secondary">Cancelar</button>
            <button type="submit" class="btn btn-primary" id="editarEnderecoUsuario">Salvar endereço</button>
          </section>
        </form>
      </section>
    </main>
  </main>
  <script src="/controller/upload-img.js" defer></script>
</body>

</html>