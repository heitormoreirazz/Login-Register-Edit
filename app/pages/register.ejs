<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Página de Registro</title>
  <link rel="stylesheet" href="../sources/register.css">
</head>
<style></style>

<body>
  <header class="nav-bar">
            <h1><a href="/">Menu Inicial</a></h1>
  </header>
  <main>
    <section class="container">
      <section class="form-container">
        <form action="/fazerRegistro" method="POST">
         
          <label for="nome">Primeiro Nome: </label>
          <input type="text" id="nome" name="nome" value="<%= valores.nome %>" required>
          <label for="sobrenome">Sobrenome: </label>
          <input type="text" id="sobrenome" name="sobrenome" value="<%= valores.sobrenome %>" required>
          <label for="email">Email: </label>
          <input type="email" id="email" name="email" value="<%= valores.email %>" required>
          <label for="password">Senha: </label>
          <input type="password" id="password" name="senha" minlength="8" required>
          <label for="confirmarSenha">Confirmar senha: </label>
          <input type="password" id="confirmarSenha" name="confirmarSenha" minlength="8" required>
          <button type="submit" id="save-btn" required>Registrar</button>
           <% if (erro) { %>
            <section class="error-message">
              <p><%= erro %></p>
            </section>
          <% } %>
        </form>
      </section>
    </section>
  </main>
</body>

</html>