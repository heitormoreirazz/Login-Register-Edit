<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Página de Registro</title>
</head>
<style>
  :root {
      --bg: #f3f6fb;
      --card: #ffffff;
      --primary: #2f6fed;
      --primary-dark: #1d4fc8;
      --muted: #6b7280;
      --border: #e5e7eb;
      --text: #1f2937;
      --success: #10b981;
      --shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }
  body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
  }

  main {
    padding: 20px;
    background-color: var(--bg);
  }

  .nav-bar a {
            padding: 1%;
            color: white;
            text-type: bold;
            text-decoration: none;
        }

  header.nav-bar {
    background-color: var(--primary);
    color: var(--text);
    padding: 1%;
    text-align: center;
  }

  .container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }

  .form-container {
    width: 300px;
    background-color: var(--card);
    padding: 20px;
    border-radius: 5px;
    box-shadow: var(--shadow);
  }

  form {
    display: flex;
    flex-direction: column;
    padding: 15px;
  }

  label {
    margin-bottom: 5px;
    font-weight: bold;
  }

  input {
    margin-bottom: 15px;
    border: 1px solid var(--border);
    border-radius: 3px;
    width: 100%;
    height: 3vh;
  }

  button {
    padding: 10px;
    background-color: #1f1f1f;
    color: white;
    border: none;
    border-radius: 3px;
    cursor: pointer;
  }

  button:hover {
    background-color: #333;
  }
</style>

<body>
  <header class="nav-bar">
            <h1><a href="/">Menu Inicial</a></h1>
  </header>
  <main>
    <section class="container">
      <section class="form-container">
        <form action="/fazerRegistro" method="POST">
          <label for="nome">Primeiro Nome: </label>
          <input type="text" id="nome" name="nome" required>
          <label for="sobrenome">Segundo Nome: </label>
          <input type="text" id="sobrenome" name="sobrenome" required>
          <label for="email">Email: </label>
          <input type="email" id="email" name="email" required>
          <label for="password">Senha: </label>
          <input type="password" id="password" name="senha" required>
          <button type="submit" id="save-btn" required>Registrar</button>
        </form>
      </section>
    </section>
  </main>
</body>

</html>